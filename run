#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
python="$root/.venv/bin/python"

if [ ! -x "$python" ]; then
    printf "%s\n" "Missing .venv/bin/python. Run $root/install first." >&2
    exit 2
fi

export PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}"
exec "$python" -B -m lib.exercise "$@"
